# Base de données PostgreSQL (ex: Render, Neon, Supabase, Railway)
DATABASE_URL=

# Auth.js — générer avec `npx auth secret`
AUTH_SECRET=

# URL de l'application (utilisée pour les liens dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — envoi des emails transactionnels (rappel, jour J, suivi)
RESEND_API_KEY=
EMAIL_FROM="Votre app <notifications@votredomaine.com>"

# Secret partagé pour protéger la route de notifications planifiées.
# Doit avoir la même valeur ici, dans les variables d'env du service Render
# et dans le secret GitHub Actions CRON_SECRET (voir .github/workflows/notifications-cron.yml)
CRON_SECRET=
